# ============================================================================
# Сервер
# ============================================================================
# development включает: длинный срок жизни JWT (365d), CORS для localhost,
# swagger server url через HOST:PORT. В production — короткие токены и
# доменный allowlist (agents./admin.rocketmind.ru, amvera).
NODE_ENV=development
PORT=3000
# Используется только для формирования server url в Swagger.
HOST=http://localhost

# ============================================================================
# MongoDB (обязательно)
# ============================================================================
MONGODB_URI=mongodb://localhost:27017/r-accelerator

# ============================================================================
# JWT (обязательно) — секреты подписи access/refresh токенов
# ============================================================================
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# ============================================================================
# Аутентификация / куки
# ============================================================================
# Домен, на который ставятся auth-куки (Set-Cookie domain). В проде —
# общий родительский домен для agents./admin. поддоменов (например,
# .rocketmind.ru). Локально можно оставить пустым (host-only cookie).
MAIN_DOMAIN=

# ============================================================================
# Первичный суперадмин (опционально)
# ============================================================================
# Если задан — при старте создаётся пользователь-суперадмин с этим email
# (если его ещё нет). Если пусто — шаг пропускается.
SUPERADMIN_EMAIL=

# ============================================================================
# S3-совместимое хранилище (обязательно для загрузки файлов) — Timeweb Cloud
# см. docs/file-storage.md
# ============================================================================
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# Обязателен для большинства не-AWS S3-совместимых хранилищ (path-style адресация бакета).
S3_FORCE_PATH_STYLE=true
# Опционально — задать, только если публичная ссылка на объект отличается от S3_ENDPOINT (например, CDN-домен).
S3_PUBLIC_URL=

# ============================================================================
# Email / SMTP (Nodemailer) — отправка кодов подтверждения
# ============================================================================
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
# Адрес в поле "From" исходящих писем.
EMAIL_FROM=

# ============================================================================
# LLM — чат агентов Р-Акселератора (прямой OpenAI, config/openai.config.js)
# ============================================================================
# Ключ OpenAI для чата агентов. ВНИМАНИЕ: чат ходит на api.openai.com, а
# эмбеддинги — на openrouter.ai; это РАЗНЫЕ провайдеры и, как правило, разные
# ключи. Если OPENROUTER_API_KEY ниже не задан, этот ключ уходит и в OpenRouter
# (обратная совместимость) — но тогда он должен быть валиден для обоих.
OPENAI_API_KEY=

# Параметры LLM-вызовов Акселератора — общие для всех агентов
# (config/accelerator.config.js). У агента этих настроек нет, менять их можно
# только здесь. Все четыре необязательны, дефолты указаны ниже.
ACCELERATOR_LLM_MODEL=gpt-4o-mini
ACCELERATOR_LLM_TEMPERATURE=0.4
# Лимит токенов на реплику агента в чате.
ACCELERATOR_LLM_CHAT_MAX_TOKENS=1500
# Лимит токенов на документ этапа — он заметно длиннее реплики.
ACCELERATOR_LLM_DOCUMENT_MAX_TOKENS=4000

# ============================================================================
# Embeddings — единый провайдер векторизации (OpenRouter, google/gemini-embedding-2)
# config/openrouter.config.js, config/embedding.config.js
# ============================================================================
# Ключ OpenRouter для эмбеддингов. Если пусто — используется OPENAI_API_KEY.
OPENROUTER_API_KEY=
# Базовый URL OpenRouter (можно не задавать — есть дефолт).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# EMBEDDING_DIM должен совпадать с размерностью коллекций в Qdrant; при смене
# модели/размерности коллекции нужно пересоздать (docs/accelerator/README.md).
EMBEDDING_MODEL=google/gemini-embedding-2
EMBEDDING_DIM=3072

# ============================================================================
# Qdrant — векторные индексы (docs/accelerator/README.md)
# ============================================================================
QDRANT_URL=
QDRANT_API_KEY=
# Коллекция приватного проектного контекста (файлы проекта + артефакты).
QDRANT_COLLECTION=expert_context
# Коллекция глобальной базы знаний (сущность Knowledge).
QDRANT_KNOWLEDGE_COLLECTION=knowledge_context
