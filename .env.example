# Сервер
NODE_ENV=development
PORT=3000
HOST=http://localhost

# MongoDB
MONGODB_URI=mongodb://localhost:27017/r-accelerator

# JWT
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# Yandex Cloud S3
YANDEX_ACCESS_KEY_ID=
YANDEX_SECRET_ACCESS_KEY=
YANDEX_BUCKET=

# SMTP (Nodemailer)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# LLM — OpenAI (используется для чата и embeddings)
OPENAI_API_KEY=

# LLM — OpenRouter (опциональный второй провайдер, см. Agent.modelConfig.provider)
OPENROUTER_API_KEY=

# Embeddings (см. docs/open-questions.md)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Qdrant — векторный индекс экспертного контекста (docs/expert-context.md)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=qd_sk_7b3a9c1e4f2d6b8a0e5c9f1d3b7a8e2c
QDRANT_COLLECTION=expert_context
