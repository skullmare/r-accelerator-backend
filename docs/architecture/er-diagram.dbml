// RocketMind — ER Diagram (DBML for dbdiagram.io)
// Paste this file at https://dbdiagram.io/d → New Diagram → paste text

// ─── Auth & Users ────────────────────────────────────────────────────────────

Table users {
  _id           ObjectId  [pk]
  email         string    [unique, not null, note: "lowercase, trimmed"]
  role          ObjectId  [ref: > roles._id]
  firstName     string
  lastName      string
  profession    string
  fieldOfActivity string
  city          string
  openAiThreadId string   [note: "OpenAI thread ID for chat history"]
  // Auth (hidden from API responses)
  authCodeHashed   string [note: "select: false"]
  authCodeExpires  datetime [note: "select: false"]
  authCodeAttempts int    [note: "0-3, select: false"]
  lastLogin     datetime
  isSystem      boolean   [default: false]
  createdAt     datetime
  updatedAt     datetime
}

Table roles {
  _id         ObjectId  [pk]
  name        string    [unique, not null]
  permissions string[]  [note: "enum: ALL_PERMISSIONS"]
  isSystem    boolean   [default: false]
  createdAt   datetime
  updatedAt   datetime
}

// Many-to-many: users ↔ study_programs (embedded array in users)
Table user_study_programs {
  userId     ObjectId [ref: > users._id]
  programId  ObjectId [ref: > study_programs._id]

  Note: "Virtual join table — stored as studyPrograms[] inside users document"
}

// ─── Study Programs ───────────────────────────────────────────────────────────

Table study_programs {
  _id         ObjectId  [pk]
  name        string    [unique, not null]
  description string
  cover       string    [note: "URL to cover image in S3"]
  coverMeta   json      [note: "S3 metadata"]
  sequential  boolean   [default: true, note: "unlock lessons in order"]
  active      boolean   [default: true]
  qrCode      string    [unique, not null, note: "SHA-256 hash for join link"]
  createdAt   datetime
  updatedAt   datetime
}

// Embedded: study_programs.modules[]
Table program_modules {
  _id        ObjectId  [pk, note: "Auto-generated subdocument _id"]
  programId  ObjectId  [ref: > study_programs._id]
  name       string    [not null]

  Note: "Embedded array inside study_programs document"
}

// Embedded: program_modules.items[]
Table module_items {
  _id       ObjectId  [pk, note: "Auto-generated subdocument _id"]
  moduleId  ObjectId  [ref: > program_modules._id]
  type      string    [not null, note: "enum: StudyLesson | StudyAgent"]
  itemId    ObjectId  [note: "ref to study_lessons._id or study_agents._id (refPath: type)"]
}

// ─── Lessons ──────────────────────────────────────────────────────────────────

Table study_lessons {
  _id          ObjectId  [pk]
  name         string    [unique, not null]
  cover        string    [note: "URL to cover image"]
  group        ObjectId  [ref: > lesson_groups._id, note: "nullable"]
  video_url    string
  presentation_url string
  content      json      [not null, note: "TipTap/ProseMirror JSON doc"]
  createdAt    datetime
  updatedAt    datetime
}

Table lesson_groups {
  _id       ObjectId [pk]
  name      string   [unique, not null]
  createdAt datetime
  updatedAt datetime
}

// ─── AI Agents ────────────────────────────────────────────────────────────────

Table study_agents {
  _id               ObjectId [pk]
  name              string   [unique, not null]
  description       string   [not null]
  role              string   [note: "max 100 chars, system prompt role"]
  avatar            string   [not null, note: "URL to avatar image"]
  openAiAssistantId string   [not null, note: "OpenAI Assistants API ID"]
  createdAt         datetime
  updatedAt         datetime
}

Table study_messages {
  _id         ObjectId [pk]
  messageText string   [not null]
  user        ObjectId [ref: > users._id, not null]
  agent       ObjectId [ref: > study_agents._id, not null]
  author      string   [not null, note: "enum: agent | user"]
  createdAt   datetime
  updatedAt   datetime

  Note: "Index: { user, agent, createdAt DESC }"
}

// ─── Progress ─────────────────────────────────────────────────────────────────

Table study_progress {
  _id            ObjectId   [pk]
  user           ObjectId   [ref: > users._id, not null]
  program        ObjectId   [ref: > study_programs._id, not null]
  completedItems ObjectId[] [note: "IDs of completed StudyLesson or StudyAgent items"]
  createdAt      datetime
  updatedAt      datetime

  Note: "Unique index: { user, program }"
}

// ─── Files ────────────────────────────────────────────────────────────────────

Table files {
  _id                   ObjectId [pk]
  name                  string   [not null]
  url                   string   [not null, note: "Yandex Cloud S3 URL"]
  key                   string   [note: "S3 object key, used by the file-processing worker"]
  type                  string   [not null, note: "MIME type"]
  size                  int      [not null, note: "bytes"]
  uploadedBy            ObjectId [ref: > users._id, not null]
  source                string   [default: "system", note: "enum: user | system"]
  projectId             ObjectId [ref: > accelerator_projects._id, note: "nullable — set when uploaded within a project"]
  processingStatus      string   [default: "uploaded", note: "enum: uploaded|extracting|extracted|indexing|indexed|failed|unsupported"]
  extractedTextStatus   string   [default: "not_started", note: "enum: not_started|success|empty|failed|unsupported"]
  qdrantStatus          string   [default: "not_indexed", note: "enum: not_indexed|indexed|failed|stale"]
  qdrantPointIds        string[]
  textHash              string
  extractedTextPreview  string
  processingError       string
  indexedAt             datetime
  createdAt             datetime
  updatedAt             datetime
}

// ─── Р-Акселератор: экспертный контур (Sprint 3) ──────────────────────────────

Table accelerator_projects {
  _id                  ObjectId [pk]
  ownerId              ObjectId [ref: > users._id, not null]
  name                 string   [not null]
  description          string
  stage                string   [note: "enum: idea|mvp|launched|growth|scale"]
  status               string   [note: "enum: active|paused|completed|archived"]
  currentAgentId       ObjectId [ref: > accelerator_agents._id, note: "nullable — set to the first agent by order for a fresh project, null once the route is finished"]
  completedAgentIds    ObjectId[]
  contextSummary       string   [note: "always included in the LLM prompt"]
  contextVersion       int      [default: 0]
  lastActivityAt       datetime
  createdAt            datetime
  updatedAt            datetime
}

Table accelerator_agents {
  _id                 ObjectId [pk, note: "the only identifier — no separate human-readable code (see open-questions.md)"]
  systemPrompt        string   [not null, note: "the agent's main instruction"]
  completionPrompt    string   [not null, note: "plain-text stage completion condition — no schema"]
  knowledgeIds        ObjectId[] [ref: > accelerator_knowledge._id, note: "knowledge bases attached to this agent"]
  name                string   [not null]
  description         string   [note: "nullable — UI only"]
  avatarUrl           string   [note: "nullable — UI only"]
  thinkingAvatarUrl   string   [note: "nullable — UI only"]
  order               int      [not null, note: "the route is agents sorted by order"]
  nextAgentId         ObjectId [ref: > accelerator_agents._id, note: "nullable — optional override; defaults to the next agent by order"]
  createdAt           datetime
  updatedAt           datetime

  Note: "LLM and context settings are service-wide (config/accelerator.config.js), not per agent"
}

Table accelerator_knowledge {
  _id                 ObjectId [pk]
  title               string   [not null]
  description         string
  fileId              ObjectId [ref: > files._id, note: "nullable — exactly one of fileId/sourceUrl is set"]
  sourceUrl           string   [note: "nullable — external link fetched over HTTP"]
  status              string   [note: "enum: pending|processing|indexed|unsupported|failed"]
  chunksCount         int      [default: 0]
  qdrantPointIds      string[]
  textHash            string
  processingError     string
  processingErrorCode string
  indexedAt           datetime
  createdBy           ObjectId [ref: > users._id]
  createdAt           datetime
  updatedAt           datetime

  Note: "Indexed into the separate knowledge_context Qdrant collection, filtered by knowledgeId"
}

Table expert_sessions {
  _id                     ObjectId [pk]
  projectId               ObjectId [ref: > accelerator_projects._id, not null]
  agentId                 ObjectId [ref: > accelerator_agents._id, not null]
  status                  string   [note: "enum: active|completed"]
  collectedData           json     [note: "free-form key/value store filled by the agent via save_data"]
  readyForArtifact        boolean  [default: false, note: "set by the agent via stage_ready — a UI hint, not a server-side gate"]
  artifactId              ObjectId [ref: > accelerator_artifacts._id, note: "nullable"]
  createdAt               datetime
  updatedAt               datetime
}

Table accelerator_messages {
  _id         ObjectId [pk]
  sessionId   ObjectId [ref: > expert_sessions._id, not null]
  projectId   ObjectId [ref: > accelerator_projects._id, not null]
  senderType  string   [not null, note: "enum: user|assistant|system"]
  content     string   [not null]
  tokenUsage  json
  createdAt   datetime

  Note: "Index: { sessionId, createdAt ASC }"
}

Table accelerator_artifacts {
  _id              ObjectId [pk]
  projectId        ObjectId [ref: > accelerator_projects._id, not null]
  expertSessionId  ObjectId [ref: > expert_sessions._id, not null]
  agentId          ObjectId [ref: > accelerator_agents._id, not null]
  title            string   [not null]
  documentMarkdown string   [not null, note: "source of the rendered PDF"]
  summary          string   [not null, note: "folded into accelerator_projects.contextSummary"]
  file             json     [note: "{ key, url, mimeType, size } — PDF in S3"]
  createdAt        datetime
  updatedAt        datetime
}

Table jobs {
  _id          ObjectId [pk]
  type         string   [not null, note: "e.g. file:process"]
  payload      json     [default: "{}"]
  status       string   [note: "enum: pending|processing|completed|failed"]
  attempts     int      [default: 0]
  maxAttempts  int      [default: 5]
  runAt        datetime
  lockedAt     datetime
  lastError    string
  createdAt    datetime
  updatedAt    datetime

  Note: "Mongo-backed durable queue. Claiming a job is a single atomic findOneAndUpdate, so it's safe across multiple server replicas without extra coordination."
}
