# Сервер
NODE_ENV=development
PORT=3000
HOST=http://localhost

# MongoDB
MONGODB_URI=mongodb://localhost:27017/r-accelerator

# JWT
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# S3-совместимое хранилище (сейчас — Timeweb Cloud, см. docs/file-storage.md)
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# Обязателен для большинства не-AWS S3-совместимых хранилищ (path-style адресация бакета).
S3_FORCE_PATH_STYLE=true
# Опционально — задать, только если публичная ссылка на объект отличается от S3_ENDPOINT (например, CDN-домен).
S3_PUBLIC_URL=

# SMTP (Nodemailer)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# LLM — OpenAI (единственный провайдер, используется для чата и embeddings)
OPENAI_API_KEY=

# Embeddings (см. docs/open-questions.md)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Qdrant — векторный индекс экспертного контекста (docs/expert-context.md)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=
