# Сервер
NODE_ENV=development
PORT=3000
HOST=http://localhost

# MongoDB
MONGODB_URI=mongodb://localhost:27017/r-accelerator

# JWT
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# S3-совместимое хранилище (сейчас — Timeweb Cloud, см. docs/file-storage.md)
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# Обязателен для большинства не-AWS S3-совместимых хранилищ (path-style адресация бакета).
S3_FORCE_PATH_STYLE=true
# Опционально — задать, только если публичная ссылка на объект отличается от S3_ENDPOINT (например, CDN-домен).
S3_PUBLIC_URL=

# SMTP (Nodemailer)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# LLM / Embeddings
# OPENAI_API_KEY используется двумя провайдерами:
#  - чат агентов Р-Акселератора — напрямую OpenAI (config/openai.config.js);
#  - эмбеддинги (оба контура) — через OpenRouter (config/openrouter.config.js).
# По текущему решению это ОДИН ключ OpenRouter; OpenRouter OpenAI-совместим и
# для chat-completions тоже, поэтому чат работает через тот же ключ.
OPENAI_API_KEY=
# Базовый URL OpenRouter для эмбеддингов (можно не задавать — есть дефолт).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Embeddings — единый провайдер векторизации (OpenRouter, google/gemini-embedding-2).
# EMBEDDING_DIM должен совпадать с размерностью коллекций в Qdrant; при смене
# коллекции нужно пересоздать (см. config/embedding.config.js, docs/expert-context.md).
EMBEDDING_MODEL=google/gemini-embedding-2
EMBEDDING_DIM=3072

# Qdrant — векторные индексы (docs/expert-context.md)
QDRANT_URL=
QDRANT_API_KEY=
# Коллекция приватного проектного контекста (файлы проекта + артефакты).
QDRANT_COLLECTION=expert_context
# Коллекция глобальной базы знаний (сущность Knowledge).
QDRANT_KNOWLEDGE_COLLECTION=knowledge_context
